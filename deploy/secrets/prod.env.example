# 生产环境秘密（复制为 prod.env）。必须与 test.env 使用不同 pepper/JWT/华为正式凭据。

ACCOUNT_UNION_ID_PEPPER=REPLACE_ME
REDEMPTION_CODE_PEPPER=REPLACE_ME
ONEBEAT_JWT_SIGNING_KEY=REPLACE_ME

HUAWEI_CLIENT_ID=REPLACE_ME
HUAWEI_ACCOUNT_CLIENT_SECRET=REPLACE_ME

# 华为 IAP 服务端密钥已不需要：付费购买自 2026-11-03 起只在客户端完成。

REDEMPTION_CODES_PATH=/run/secrets/redemption_codes.json
STORE_SECRETS_DIR=/run/secrets
