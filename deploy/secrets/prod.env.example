# 生产环境秘密（复制为 prod.env）。必须与 test.env 使用不同 pepper/JWT/华为正式凭据。

ACCOUNT_UNION_ID_PEPPER=REPLACE_ME
PURCHASE_BINDING_SECRET=REPLACE_ME
PURCHASE_TOKEN_ENCRYPTION_KEY=REPLACE_ME
REDEMPTION_CODE_PEPPER=REPLACE_ME
ONEBEAT_JWT_SIGNING_KEY=REPLACE_ME

HUAWEI_CLIENT_ID=REPLACE_ME
HUAWEI_ACCOUNT_CLIENT_SECRET=REPLACE_ME

HUAWEI_IAP_ENVIRONMENT=production
# 预留兼容字段；当前 Harmony IAP 请求 JWT 鉴权不读取它。
HUAWEI_IAP_CLIENT_SECRET=REPLACE_ME
# AGC「应用内支付 → 配置密钥」下载的 EC P-256 私钥（Harmony IAP REST / ES256）。
# PEM 单行保存，换行写成 \n；不要使用 API Console 的 RSA 服务账号私钥。
HUAWEI_IAP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_EC_P256_PEM\n-----END PRIVATE KEY-----"
# 与同一套 IAP 配置密钥配套的 key_id 和 issuer ID。
HUAWEI_IAP_KEY_ID=REPLACE_ME
HUAWEI_IAP_ISSUER_ID=REPLACE_ME

REDEMPTION_CODES_PATH=/run/secrets/redemption_codes.json
STORE_SECRETS_DIR=/run/secrets
