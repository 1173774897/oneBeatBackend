# 密码建议只使用 `openssl rand -hex 32` 生成的十六进制字符，避免 URL 转义错误。
DATABASE_URL=postgres://onebeat_prod:replace_with_prod_password@onebeat-postgres:5432/onebeat_prod?sslmode=disable

# 生产订单对账 worker。日常对账始终启用；历史回补只在首次上线或人工修复时临时开启。
IAP_RECONCILIATION_TIMEZONE=Asia/Shanghai
# 首次上线保持 1；核对真实订单响应后改为 0，才允许对账写业务表和权益。
IAP_RECONCILIATION_OBSERVE_ONLY=1
IAP_BACKFILL_ENABLED=0
IAP_BACKFILL_DAYS=180
