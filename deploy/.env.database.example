# PostgreSQL 管理账号只用于初始化、维护和备份，不提供给 API。
POSTGRES_USER=onebeat_admin
POSTGRES_PASSWORD=replace_with_a_random_hex_password
POSTGRES_DB=postgres

# 两个运行环境使用不同账号，只能访问各自拥有的数据库。
ONEBEAT_PROD_DB_USER=onebeat_prod
ONEBEAT_PROD_DB_PASSWORD=replace_with_a_different_random_hex_password
ONEBEAT_TEST_DB_USER=onebeat_test
ONEBEAT_TEST_DB_PASSWORD=replace_with_another_random_hex_password

